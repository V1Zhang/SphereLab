{
  "name": "spherelab-desktop",
  "version": "0.3.2",
  "private": true,
  "description": "SphereLab desktop wrapper",
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.mjs",
    "start": "electron .",
    "pack": "npm run prepare-app && electron-builder --dir",
    "build": "npm run prepare-app && electron-builder"
  },
  "build": {
    "appId": "com.spherelab.desktop",
    "productName": "SphereLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app-dist",
        "to": "app-dist"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Graphics"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
