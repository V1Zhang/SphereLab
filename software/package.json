{
  "name": "spherelab-desktop",
  "version": "0.4.1",
  "private": true,
  "description": "SphereLab desktop wrapper",
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.mjs",
    "start": "electron .",
    "pack": "npm run prepare-app && electron-builder --dir",
    "build": "npm run prepare-app && electron-builder",
    "release:mac": "npm run prepare-app && electron-builder --mac --arm64 --publish never"
  },
  "build": {
    "appId": "com.spherelab.desktop",
    "productName": "SphereLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app-dist",
        "to": "app-dist"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Graphics"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.graphics-design",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
